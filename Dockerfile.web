FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY apps/web ./apps/web
RUN npm run build:web
FROM nginxinc/nginx-unprivileged:1.28-alpine
ENV NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1 BACKEND_HOST=api
COPY infra/nginx.conf /etc/nginx/templates/default.conf.template
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s CMD wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1
